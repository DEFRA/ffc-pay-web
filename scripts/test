#!/usr/bin/env sh

set -e
projectRoot="$(a="/$0"; a=${a%/*}; a=${a:-.}; a=${a#/}/; cd "$a/.." || return; pwd)"

service="ffc-pay-web"

show_help() {
  echo "
    Usage: scripts/test [OPTION...]
    Run tests.

    Options:
      -w, --watch   watch tests
      -d, --debug   debug tests
      -h, --help    display this help text
    "
}

while :; do
  case $1 in
    -w|--watch)
      watch="true"
      ;;

    -d|--debug)
      debug="true"
      ;;

    -h|--help)   # Call a "show_help" function to display a synopsis, then exit.
      show_help
      exit
      ;;
    *)
      break
  esac

  shift
done

compose() {
  if [ "${watch}" = "true" ]; then
    docker compose -f docker-compose.yaml -f docker-compose.link.yaml -f docker-compose.test.yaml -f docker-compose.test.watch.yaml -p "${service}-test" "$@"
  elif [ "${debug}" = "true" ]; then
    docker compose -f docker-compose.yaml -f docker-compose.link.yaml -f docker-compose.test.yaml -f docker-compose.test.watch.yaml -f docker-compose.test.debug.yaml -p "${service}-test" "$@"
  else
    docker compose -f docker-compose.yaml -f docker-compose.link.yaml -f docker-compose.test.yaml -p "${service}-test" "$@"
  fi
}

(
  cd "${projectRoot}"

  # Create test-output folder
  mkdir -p test-output

  # Guarantee clean environment
  compose down -v

  # Ensure container images are up to date
  compose build

  # Run tests
  if [ "${debug}" = "true" ]; then
    compose run --service-ports ${service} ${command}
  else
    compose run ${service} ${command}
  fi

  # Clean up
  compose down -v
)

# Report the Sonar Quality Gate for this branch using the coverage just generated
if [ "${SONAR_SKIP_AUTOCHECK}" != "true" ]; then
  if [ -n "${SONAR_TOKEN}" ]; then
    "${projectRoot}/scripts/sonar" --after-tests
  else
    yellow='' dim='' reset=''
    if [ -t 1 ] && [ -z "${NO_COLOR}" ]; then yellow='\033[1;33m' dim='\033[2m' reset='\033[0m'; fi
    printf '\n%b⚠ SonarCloud Quality Gate check is not set up (SONAR_TOKEN is not set), so it was skipped.%b\n' "${yellow}" "${reset}"
    printf '%b  Run ./setup in ffc-pay-core to add your token, or see scripts/sonar --help.%b\n' "${dim}" "${reset}"
  fi
fi
