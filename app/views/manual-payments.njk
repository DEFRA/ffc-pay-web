{% extends '_layout.njk' %}
{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/file-upload/macro.njk" import govukFileUpload %}
{%
  from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner
%}

{% set pageTitle = "Upload manual payments" %}
{% block pageTitle %}{{ pageTitle }} - {{ serviceName }}{% endblock %}
{% block beforeContent %}
  {{
    govukBreadcrumbs({
      items: [{
        text: "Home",
        href: "/"
      }, {
      text: pageTitle
      }]
    })
  }}
{% endblock %}
{% block content %}
  {%
    set pdfDownloadLink = '/status-report/download?file-name=' ~ 'reports/DS1-Manual payment upload - service design.pdf' | urlencode
  %}
  {# The upload route sends errors in three different shapes depending on
     what went wrong:
       - too-large file:  { path: 'payload', message: '...' }
       - empty file:      { path: 'file-empty', message: '...' }
       - other Joi errors: raw Joi ValidationError, where each detail's
         path is an ARRAY, e.g. path: ['file']
     fileFieldValues covers every identifier that means "this error
     belongs to the file input" so both the summary link and the
     field-level message match correctly regardless of which shape
     produced the error. #}
  {% set fileFieldValues = ['file', 'payload', 'file-empty'] %}
  {% set fileError = null %}
  {% if errors %}
    {% for err in errors.details %}
      {% set candidateField = null %}
      {% if err.path is string %}
        {% set candidateField = err.path %}
      {% elif err.path %}
        {% set candidateField = err.path[0] %}
      {% endif %}
      {% if not candidateField and err.context and err.context.key %}
        {% set candidateField = err.context.key %}
      {% endif %}
      {% if candidateField in fileFieldValues %}
        {% set fileError = err.message %}
      {% endif %}
    {% endfor %}
  {% endif %}
  {% set fileErrorMessage = null %}
  {% if fileError %}
    {% set fileErrorMessage = { text: fileError } %}
  {% endif %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      {% if success %}
        {{
          govukNotificationBanner({
            type: "success",
            titleText: "Success",
            text: "Payment file has been successfully uploaded."
          })
        }}
      {% endif %}
      {% if errors %}
        <div
          class="govuk-error-summary"
          aria-labelledby="error-summary-title"
          role="alert"
          tabindex="-1"
          data-module="govuk-error-summary">
          <h2
            class="govuk-error-summary__title"
            id="error-summary-title">
            There is a problem
          </h2>
          <div class="govuk-error-summary__body">
            <ul class="govuk-list govuk-error-summary__list">
              {% for errorDetail in errors.details %}
                {% set errCandidateField = null %}
                {% if errorDetail.path is string %}
                  {% set errCandidateField = errorDetail.path %}
                {% elif errorDetail.path %}
                  {% set errCandidateField = errorDetail.path[0] %}
                {% endif %}
                {%
                  if not errCandidateField and errorDetail.context and errorDetail.context.key
                %}
                  {% set errCandidateField = errorDetail.context.key %}
                {% endif %}
                <li>
                  {% if errCandidateField in fileFieldValues %}
                    <a
                      href="#file"
                      class="govuk-error-message">{{ errorDetail.message }}</a>
                  {% else %}
                    <span class="govuk-error-message"><span
                        class="govuk-visually-hidden">Error:</span> {{
                        errorDetail.message
                      }}</span>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          </div>
        </div>
      {% endif %}
      <h1 class="govuk-heading-l">{{ pageTitle }}</h1>
      <p class="govuk-body">
        Upload payment files to be manually processed. For more information on
        uploading manual payments, including the file format you can download
        <a
          class="govuk-link"
          href="{{ pdfDownloadLink }}"
          target="_blank"
          rel="noopener noreferrer">manual payments guidance (PDF, 2MB)</a>.
      </p>
      <form
        method="POST"
        action="/manual-payments/upload"
        autocomplete="off"
        novalidate
        enctype="multipart/form-data">
        <input
          type="hidden"
          name="crumb"
          value="{{ crumb }}"
        />
        {{
          govukFileUpload({
            id: "file",
            name: "file",
            label: {
              html: '<span class="govuk-!-font-weight-bold">Upload a CSV file</span>'
            },
            javascript: true,
            errorMessage: fileErrorMessage
          })
        }}
        {{
          govukButton({
            text: "Upload",
            attributes: {
              id: "submit"
            }
          })
        }}
      </form>
      <div class="govuk-grid-row govuk-!-margin-top-6">
        <div class="govuk-grid-column-full">
          <h2 class="govuk-heading-m">Upload history</h2>
          {% if uploadHistory and uploadHistory.length > 0 %}
            <table class="govuk-table govuk-!-margin-bottom-0">
              <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                  <th class="govuk-table__header">Date uploaded</th>
                  <th class="govuk-table__header">Filename</th>
                  <th class="govuk-table__header">Name</th>
                  <th class="govuk-table__header">Actions</th>
                </tr>
              </thead>
              <tbody class="govuk-table__body">
                {% for upload in uploadHistory %}
                  <tr class="govuk-table__row">
                    <td class="govuk-table__cell">{{ upload.timeStamp }}</td>
                    <td class="govuk-table__cell">{{ upload.filename }}</td>
                    <td class="govuk-table__cell">{{ upload.uploader }}</td>
                    {% if upload.success == true %}
                      <td class="govuk-table__cell">
                        <a
                          href="/monitoring/batch/name?batch={{ upload.filename }}"
                          class="govuk-link">View payment status</a>
                      </td>
                    {% elif upload.success == false %}
                      <td class="govuk-table__cell">Payment file rejected</td>
                    {% else %}
                      <td class="govuk-table__cell">Payment file processing</td>
                    {% endif %}
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          {% else %}
            <div class="govuk-inset-text">
              There are no uploads to show yet. You can upload a file using the
              form above.
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
{% endblock %}
