{% extends '_layout.njk' %}

{% from 'macros/events-breadcrumbs.njk' import eventsBreadcrumbs %}

{% set pageTitle = "FRN agreement details" %}

{% block pageTitle %}{{ pageTitle }} - {{ serviceName }}{% endblock %}

{% block beforeContent %}
  {{ eventsBreadcrumbs(pageTitle) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h1 class="govuk-heading-l">{{ pageTitle }}</h1>

      <p class="govuk-body-m">
        View the details for the chosen FRN agreement.
      </p>

      <h1 class="govuk-heading-m">
        {{ events.frn }} - {{ events.agreementNumber }}
      </h1>

      {% if events %}
        <table class="govuk-table">
          <thead class="govuk-table__head">
            <tr class="govuk-table__row">
              <th
                scope="col"
                class="govuk-table__header govuk-body-s">
                Activity
              </th>
              <th
                scope="col"
                class="govuk-table__header govuk-body-s">
                Status
              </th>
              <th
                scope="col"
                class="govuk-table__header govuk-table__header--numeric govuk-body-s">
                Completed
              </th>
            </tr>
          </thead>
          <tbody class="govuk-table__body">
            {% for event in events.events %}
              <tr class="govuk-table__row">
                <td class="govuk-table__cell govuk-body-s">
                  {{ event.status.name }}
                </td>
                <td class="govuk-table__cell govuk-body-s">
                  {% if event.timestamp %}
                    <strong
                      class="govuk-tag govuk-tag--green">Completed</strong>
                  {% elif events.events[loop.index0 - 1].lastEvent %}
                    <span class="govuk-tag">In progress</span>
                  {% else %}
                    <strong class="govuk-tag govuk-tag--grey">Not started
                      yet</strong>
                  {% endif %}
                </td>
                <td
                  class="govuk-table__cell govuk-table__cell--numeric govuk-body-s">
                  {{ event.timestamp }}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      {% else %}
        <p
          id="no-hold-text"
          class="govuk-body">
          No events found for FRN {{ events.frn }}.
        </p>
      {% endif %}
    </div>
  </div>
{% endblock %}
