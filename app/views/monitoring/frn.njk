{% extends '_layout.njk' %}

{% from 'macros/events-breadcrumbs.njk' import eventsBreadcrumbs %}
{% from "govuk/components/pagination/macro.njk" import govukPagination %}

{% set pageTitle = "FRN payment history" %}
{% set hasMultiplePages = totalPages and totalPages > 1 %}

{% block pageTitle %}
  {% if hasMultiplePages %}
    Page {{ page }} - {{ pageTitle }} - {{ serviceName }}
  {% else %}
    {{ pageTitle }} - {{ serviceName }}
  {% endif %}
{% endblock %}

{% block beforeContent %}
  {{ eventsBreadcrumbs(pageTitle) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h1 class="govuk-heading-l">{{ pageTitle }}</h1>

      {% if payments.length %}
        <p class="govuk-body-m">
          View the payment history for the entered FRN or
          <a
            class="govuk-link"
            href="/monitoring">start a new search</a>.
        </p>

        <p class="govuk-body">
          We've found {{ numberOfPayments }} payment event{{
            's' if numberOfPayments != 1
          }}.
        </p>

        <h2 class="govuk-heading-m">{{ frn }} event history</h2>

        <div class="govuk-grid-row govuk-!-margin-bottom-3">
          <div class="govuk-grid-column-one-half">
            <p
              class="govuk-body-m govuk-!-margin-0"
              id="payment-event-count">
              Showing {{ payments.length }} payment event{{
                's' if payments.length != 1
              }}
            </p>
          </div>

          {% if hasMultiplePages %}
            <div class="govuk-grid-column-one-half">
              <div
                style="display:flex;align-items:baseline;justify-content:flex-end;">
                <div
                  class="govuk-body-s govuk-!-margin-0"
                  aria-label="Records per page"
                  style="white-space:nowrap;vertical-align:baseline;">
                  <span>Number of records per page:</span>&nbsp;
                  {% set perPageOptions = [100, 500, 1000] %}
                  {% for opt in perPageOptions %}
                    {% if perPage == opt %}
                      <strong>{{ opt }}</strong>
                    {% else %}
                      <a
                        class="govuk-link"
                        href="?page=1&perPage={{ opt }}{{ extraQuery }}">{{
                        opt
                      }}</a>
                    {% endif %}
                    {% if not loop.last %}
                      &nbsp;|&nbsp;
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
            </div>
          {% endif %}
        </div>

        <table class="govuk-table">
          <thead class="govuk-table__head">
            <tr class="govuk-table__row">
              <th
                scope="col"
                class="govuk-table__header govuk-body-s">
                Scheme
              </th>
              <th
                scope="col"
                class="govuk-table__header govuk-body-s">
                Agreement
              </th>
              <th
                scope="col"
                class="govuk-table__header govuk-table__header--numeric govuk-body-s">
                Payment request
              </th>
              <th
                scope="col"
                class="govuk-table__header govuk-table__header--numeric govuk-body-s">
                Value
              </th>
              <th
                scope="col"
                class="govuk-table__header govuk-body-s">
                Status
              </th>
              <th
                scope="col"
                class="govuk-table__header govuk-table__header--numeric govuk-body-s">
                Last updated
              </th>
              <th
                scope="col"
                class="govuk-table__header govuk-body-s">
                Activity
              </th>
            </tr>
          </thead>
          <tbody class="govuk-table__body">
            {% for payment in payments %}
              <tr class="govuk-table__row">
                <td class="govuk-table__cell govuk-body-s">
                  {{ payment.scheme }}
                </td>
                <td class="govuk-table__cell govuk-body-s">
                  {{ payment.agreementNumber }}
                </td>
                <td
                  class="govuk-table__cell govuk-table__cell--numeric govuk-body-s">
                  {{ payment.paymentRequestNumber }}
                </td>
                <td
                  class="govuk-table__cell govuk-table__cell--numeric govuk-body-s">
                  {{ payment.originalValueText }}
                </td>
                <td class="govuk-table__cell govuk-body-s">
                  <strong
                    class="govuk-tag {% if payment.status.state == 'Completed' %}govuk-tag--green{% elif payment.status.state == 'Waiting' %}govuk-tag--yellow{% endif %}">
                    {{ payment.status.detail }}
                  </strong>
                </td>
                <td
                  class="govuk-table__cell govuk-table__cell--numeric govuk-body-s">
                  {{ payment.lastUpdated }}
                </td>
                <td class="govuk-table__cell govuk-body-s">
                  <a
                    class="govuk-link"
                    href="/monitoring/payments/correlation-id?correlationId={{ payment.correlationId }}">View</a>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>

        {% if hasMultiplePages %}
          {% set paginationPrevious = undefined %}
          {% set paginationNext = undefined %}

          {% if page > 1 %}
            {%
              set paginationPrevious = {
                href: "?page=" + (page - 1) + "&perPage=" + perPage + extraQuery,
                labelText: "Previous page"
              }
            %}
          {% endif %}

          {% if page < totalPages %}
            {%
              set paginationNext = {
                href: "?page=" + (page + 1) + "&perPage=" + perPage + extraQuery,
                labelText: "Next page"
              }
            %}
          {% endif %}

          {{
            govukPagination({
              previous: paginationPrevious,
              next: paginationNext,
              items: paginationItems
            })
          }}
        {% endif %}
      {% else %}
        <p
          id="no-hold-text"
          class="govuk-body">
          No payment events were found for FRN {{ frn }}.
        </p>

        <p class="govuk-body">
          <a
            class="govuk-link"
            href="/monitoring">Try searching for a payment event again.</a>
        </p>
      {% endif %}
    </div>
  </div>
{% endblock %}
