{% extends '_layout.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}
{%
  from "macros/alert-helpers.njk" import confirmationQueryParams, recipientSummaryCard, schemeSummaryCard, confirmationHiddenFields
%}

{%
  set pageTitle = "Check alerts for " ~ emailAddress ~ " are correct before saving"
%}
{%
  set updatePageTitle = ("Update " ~ emailAddress ~ " alerts") if contactId else "Add new alert recipient"
%}
{%
  set breadcrumbData = {
    contactId: contactId,
    emailAddress: emailAddress,
    action: action
  }
%}

{% block pageTitle %}{{ pageTitle }} - {{ serviceName }}{% endblock %}

{% block beforeContent %}
  {{
    govukBreadcrumbs({
      items: [{
        text: "Home",
        href: "/"
      }, {
        text: "Manage email alerts",
        href: "/alerts/manage"
      }, {
        text: updatePageTitle,
        href: "/alerts/update?" ~ confirmationQueryParams(breadcrumbData, schemes)
      }, {
        text: pageTitle
      }]
    })
  }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">{{ pageTitle }}</h1>

      {% if not contactId %}
        {{
          recipientSummaryCard(
            formPath,
            { emailAddress: emailAddress, action: action },
            schemes,
            null,
            null,
            emailAddress
          )
        }}
      {% endif %}

      {% set globalAlertsDisplayed = false %}

      {% for scheme in schemes %}
        {% if scheme.alertTypes and scheme.alertTypes.length %}
          {{
            schemeSummaryCard(
              scheme,
              formPath,
              {
                contactId: contactId,
                emailAddress: emailAddress,
                action: action
              },
              schemes,
              scheme.schemeId,
              scheme.schemeId,
              formatAlertType,
              globalAlertTypes if not globalAlertsDisplayed else []
            )
          }}

          {% set globalAlertsDisplayed = true %}
        {% endif %}
      {% endfor %}

      {% if not hasSchemeAlerts and globalAlertTypes.length %}
        <div class="govuk-summary-card">
          <div class="govuk-summary-card__title-wrapper">
            <h2 class="govuk-summary-card__title">
              Alerts
            </h2>

            <ul class="govuk-summary-card__actions">
              <li class="govuk-summary-card__action">
                <a
                  class="govuk-link"
                  href="{{ formPath }}?contactId={{ contactId | urlencode }}&emailAddress={{ emailAddress | urlencode }}&action={{ action | urlencode }}{% for alertType in globalAlertTypes %}&globalAlerts={{ alertType | urlencode }}{% endfor %}">
                  Change
                  <span class="govuk-visually-hidden">
                    alert settings
                  </span>
                </a>
              </li>
            </ul>
          </div>

          <div class="govuk-summary-card__content">
            <dl class="govuk-summary-list">
              <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">
                  Alert types
                </dt>

                <dd class="govuk-summary-list__value">
                  <ul class="govuk-list">
                    {% for alertType in globalAlertTypes %}
                      <li>{{ formatAlertType(alertType) }}</li>
                    {% endfor %}
                  </ul>
                </dd>
              </div>
            </dl>
          </div>
        </div>
      {% endif %}

      <form
        method="POST"
        action="{{ formAction }}"
        autocomplete="off"
        novalidate>
        {{
          confirmationHiddenFields(crumb, contactId, emailAddress, action, schemeId, schemes, globalAlertTypes)
        }}

        {{
          govukButton({
            text: "Confirm changes",
            attributes: {
              id: "submit",
              type: "submit"
            }
          })
        }}
      </form>
    </div>
  </div>
{% endblock %}
