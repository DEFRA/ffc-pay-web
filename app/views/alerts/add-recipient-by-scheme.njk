{% extends '_layout.njk' %}

{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{%
  from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner
%}
{%
  from "macros/alert-helpers.njk" import hiddenRecipientFields, alertCheckboxes, alertToggleScript
%}

{% if error and not schemeName %}
  {% set pageTitle = "Manage email alerts by scheme" %}
{% elif schemeName %}
  {% set pageTitle = "Add new alert recipient for " ~ schemeName %}
{% else %}
  {% set pageTitle = "Add new alert recipient" %}
{% endif %}

{% block pageTitle %}{{ pageTitle }} - {{ serviceName }}{% endblock %}

{% block beforeContent %}
  {% if error and not schemeName %}
    {{
      govukBreadcrumbs({
        items: [{
          text: "Home",
          href: "/"
        }, {
          text: "Manage email alerts",
          href: "/alerts/manage"
        }, {
          text: "Manage email alerts by scheme"
        }]
      })
    }}
  {% else %}
    {{
      govukBreadcrumbs({
        items: [{
          text: "Home",
          href: "/"
        }, {
          text: "Manage email alerts",
          href: "/alerts/manage"
        }, {
          text: "Manage email alerts by scheme",
          href: "/alerts/manage-by-scheme"
        }, {
          text: schemeName ~ " email alerts",
          href: "/alerts/by-scheme?schemeId=" ~ (schemeId | urlencode)
        }, {
          text: pageTitle
        }]
      })
    }}
  {% endif %}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      {% if error and not schemeName %}
        {{
          govukErrorSummary({
            titleText: "There is a problem",
            errorList: [{ text: error, href: "#schemeId" }]
          })
        }}

        <h1 class="govuk-heading-l">{{ pageTitle }}</h1>

        <p class="govuk-body">
          Select a scheme to add a new alert recipient.
        </p>

        <form
          method="GET"
          action="/alerts/add-recipient-by-scheme"
          class="govuk-!-margin-bottom-6">
          {% set schemeItems = [] %}
          {% for scheme in data %}
            {%
              set schemeItems = (schemeItems.push({
                value: scheme.schemeId,
                text: scheme.name
              }), schemeItems)
            %}
          {% endfor %}

          {{
            govukSelect({
              id: "schemeId",
              name: "schemeId",
              label: {
                text: "Select scheme",
                classes: "govuk-label--s"
              },
              items: schemeItems
            })
          }}

          <div class="govuk-button-group">
            {{
              govukButton({
                text: "Search",
                attributes: {
                  id: "submit"
                }
              })
            }}
          </div>
        </form>
      {% else %}
        {% if successMessage %}
          {% set successHtml %}
            <p class="govuk-notification-banner__heading">
              {{ successMessage }}
            </p>
          {% endset %}

          {{
            govukNotificationBanner({
              type: "success",
              titleText: "Success",
              html: successHtml
            })
          }}
        {% endif %}

        {% if error %}
          <div
            class="govuk-error-summary"
            aria-labelledby="error-summary-title"
            role="alert"
            tabindex="-1"
            data-module="govuk-error-summary">
            <h2
              class="govuk-error-summary__title"
              id="error-summary-title">
              There is a problem
            </h2>

            <div class="govuk-error-summary__body">
              <ul class="govuk-list govuk-error-summary__list">
                <li>
                  <a href="#emailAddress">
                    {{ error }}
                  </a>
                </li>
              </ul>
            </div>
          </div>
        {% endif %}

        <h1 class="govuk-heading-l">{{ pageTitle }}</h1>

        <p class="govuk-body">
          Add a new recipient to all alerts or by alert type for this scheme.
          Alternatively,
          <a
            href="/alerts/update"
            class="govuk-link">
            add a new recipient for multiple schemes.
          </a>
        </p>

        <p class="govuk-body">
          Find out more about alert types on the
          <a
            href="/alerts/information"
            class="govuk-link"
            target="_blank"
            rel="noopener noreferrer">
            alerts information page
          </a>
          (opens in a new tab).
        </p>

        <form
          method="POST"
          action="{{ formAction or '/alerts/update-confirm' }}">
          {{
            hiddenRecipientFields({
              crumb: crumb,
              contactId: contactId,
              action: 'create',
              schemeId: schemeId,
              includeEmailAddress: false
            })
          }}

          <div
            class="govuk-form-group{% if error %} govuk-form-group--error{% endif %}">
            <label
              class="govuk-label govuk-label--s"
              for="emailAddress">
              Email address
            </label>

            {% if error %}
              <span
                id="emailAddress-error"
                class="govuk-error-message">
                <span class="govuk-visually-hidden">Error:</span>
                {{ error }}
              </span>
            {% endif %}

            <input
              class="govuk-input{% if error %} govuk-input--error{% endif %}"
              id="emailAddress"
              name="emailAddress"
              type="email"
              value="{{ emailAddress or '' }}"
              {% if error %}aria-describedby="emailAddress-error"{% endif %}
            />
          </div>

          {{
            alertCheckboxes({
              schemesPayload: schemesPayload,
              alertTypesPayload: alertTypesPayload,
              selectedAlerts: selectedAlerts
            })
          }}

          {{ govukButton({ text: "Continue" }) }}
        </form>
      {% endif %}
    </div>
  </div>
  {{ alertToggleScript() }}
{% endblock %}
