{% extends '_layout.njk' %}

{%
  from "macros/alert-helpers.njk" import alertManagementBreadcrumbs, alertManagementPageContent
%}

{% set pageTitle = "Manage email alerts by scheme" %}

{% block pageTitle %}{{ pageTitle }} - {{ serviceName }}{% endblock %}

{% block beforeContent %}
  {{ alertManagementBreadcrumbs(pageTitle) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      {{
        alertManagementPageContent(
          pageTitle,
          [
            "Select a scheme to manage its email alerts.",
            "Use the cards below to choose the scheme you want to review or update."
          ],
          cards,
          updated,
          removed,
          emailAddress
        )
      }}
    </div>
  </div>
{% endblock %}
