{% extends '_layout.njk' %}

{% from "macros/alert-helpers.njk" import alertManagementBreadcrumbs %}

{% set pageTitle = "Alerts information" %}

{% block pageTitle %}{{ pageTitle }} - {{ serviceName }}{% endblock %}

{% block beforeContent %}
  {{ alertManagementBreadcrumbs(pageTitle) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">{{ pageTitle }}</h1>
      <p class="govuk-body">
        This page details the various alert types utilised by Payment Hub, as
        well as guidance on the expected outcomes from each alert type.
      </p>
      {% if alertDescriptions.length %}
        <h2 class="govuk-heading-m">Contents</h2>
        <ul class="govuk-list govuk-list--bullet">
          {% for alert in alertDescriptions %}
            {% set alertForId = alert.type | lower | replace(' ', '-') %}
            {% if alert.type %}
              {% set parts = alert.type.split('_') %}
            {% else %}
              {% set parts = [] %}
            {% endif %}
            <li>
              <a
                class="govuk-link"
                href="#{{ alertForId }}">
                {% for part in parts %}
                  {{ part | capitalize }}{% if not loop.last %} {% endif %}
                {% endfor %}
              </a>
            </li>
          {% endfor %}
        </ul>
        {% for alert in alertDescriptions %}
          {% set alertForId = alert.type | lower | replace(' ', '-') %}
          {% if alert.type %}
            {% set parts = alert.type.split('_') %}
          {% else %}
            {% set parts = [] %}
          {% endif %}
          <h2
            id="{{ alertForId }}"
            class="govuk-heading-m">
            {% for part in parts %}
              {{ part | capitalize }}{% if not loop.last %} {% endif %}
            {% endfor %}
          </h2>
          {% for line in alert.description %}
            <p class="govuk-body">
              {{ line }}
            </p>
          {% endfor %}
        {% endfor %}
      {% else %}
        <p
          id="no-alerts-text"
          class="govuk-body">
          There are no alerts offered by the Payment Hub, or there was a
          temporary issue in loading alert types.
        </p>
      {% endif %}
    </div>
  </div>
{% endblock %}
