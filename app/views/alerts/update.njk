{% extends '_layout.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% if contactId %}
  {% set pageTitle = "Update alert recipient" %}
{% else %}
  {% set pageTitle = "Add new alert recipient" %}
{% endif %}

{% block pageTitle %}{{ pageTitle }} - {{ serviceName }}{% endblock %}

{% block beforeContent %}
  {% include "macros/alert-breadcrumbs.njk" %}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <form
        method="POST"
        action="/alerts/update"
        autocomplete="off"
        novalidate>
        <input
          type="hidden"
          name="crumb"
          value="{{crumb}}"
        />
        <input
          type="hidden"
          name="contactId"
          value="{{contactId}}"
        />

        {% if error %}
          {%
            set errorList = [{
              text: error.message,
              href: "#emailAddress"
            }]
          %}

          {{
            govukErrorSummary({
              titleText: "There is a problem",
              errorList: errorList
            })
          }}
        {% endif %}

        {% set emailAddressError = null %}

        {% if error %}
          {%
            set emailAddressError = {
              text: error.message
            }
          %}
        {% endif %}

        <h1 class="govuk-heading-l">{{ pageTitle }}</h1>

        {{
          govukInput({
            label: {
              text: "Email address",
              classes: "govuk-label-s"
            },
            id: "emailAddress",
            name: "emailAddress",
            type: "email",
            value: emailAddress,
            errorMessage: emailAddressError
          })
        }}
        <div class="govuk-form-group">
          <label
            class="govuk-label"
            for="selectView">
            Select a scheme to view alerts for
          </label>
          <select
            class="govuk-select"
            id="selectView"
            name="selectView">
            <option
              value="all"
              {% if selectView == 'all' or selectView == null %}
                selected
              {% endif %}>
              All
            </option>
            {% for scheme in schemesPayload %}
              <option
                value="{{ scheme.schemeId }}"
                {% if selectView == scheme.schemeId %}selected{% endif %}>
                {{ scheme.name }}
              </option>
            {% endfor %}
          </select>
        </div>

        {% for scheme in schemesPayload %}
          <div
            class="govuk-form-group scheme-group"
            data-scheme-id="{{ scheme.schemeId }}">
            {% set schemeForId = scheme.name | lower | replace(' ', '-') %}
            <fieldset class="govuk-fieldset">
              <legend class="govuk-fieldset__legend">
                Alert types for {{ scheme.name }}
              </legend>
              <div
                class="govuk-checkboxes"
                data-module="govuk-checkboxes">
                <div class="govuk-checkboxes__item">
                  <input
                    class="govuk-checkboxes__input"
                    id="{{ schemeForId }}-all"
                    name="{{ scheme.schemeId }}"
                    type="checkbox"
                    value="all"
                    data-behaviour="exclusive"
                  />
                  <label
                    class="govuk-label govuk-checkboxes__label"
                    for="{{ schemeForId }}-all">
                    Receive all alerts for this scheme
                  </label>
                </div>
                <div
                  id="{{schemeForId}}-hint"
                  class="govuk-hint govuk-!-margin-top-3 govuk-!-margin-bottom-3">
                  or, select individual alerts to receive:
                </div>
                {% for alertType in alertTypesPayload %}
                  <div class="govuk-checkboxes__item">
                    {% set alertForId = alertType | lower | replace(' ', '-') %}
                    <input
                      class="govuk-checkboxes__input"
                      id="{{ schemeForId }}-{{ alertForId }}"
                      name="{{ scheme.schemeId }}"
                      type="checkbox"
                      value="{{ alertType }}"
                      {%
                        if selectedAlerts[alertType] and selectedAlerts[alertType][scheme.schemeId]
                      %}
                        checked
                      {% endif %}
                    />
                    {% set parts = alertType.split('_') %}
                    <label
                      class="govuk-label govuk-checkboxes__label"
                      for="{{ schemeForId }}-{{ alertForId }}">
                      {% for part in parts %}
                        {{ part | capitalize }}{% if not loop.last %}
                        {% endif %}
                      {% endfor %}
                    </label>
                  </div>
                {% endfor %}
              </div>
            </fieldset>
          </div>
        {% endfor %}
        <div class="govuk-button-group">
          {% if contactId %}
            {{
              govukButton({
                text: "Confirm changes",
                attributes: {
                  id: "submit",
                  type: "submit",
                  name: "action",
                  value: "edit"
                }
              })
            }}
            <button
              onclick="window.location.href='/alerts/confirm-delete?contactId={{ contactId }}'"
              type="button"
              class="govuk-button govuk-button--warning"
              data-module="govuk-button">
              Remove email
            </button>
          {% else %}
            {{
              govukButton({
                text: "Create",
                attributes: {
                  id: "submit",
                  type: "submit",
                  name: "action",
                  value: "create"
                }
              })
            }}
          {% endif %}
        </div>
      </form>
    </div>
  </div>
  <script>
  document.addEventListener('DOMContentLoaded', function () {
      const selectView = document.getElementById('selectView')
      const schemeGroups = document.querySelectorAll('.scheme-group')

      function filterSchemes() {
        const selected = selectView.value
        schemeGroups.forEach(group => {
          if (selected === 'all' || group.dataset.schemeId === selected) {
            group.style.display = 'block'
          } else {
            group.style.display = 'none'
          }
        })
      }

      selectView.addEventListener('change', filterSchemes)

      filterSchemes()
    })
  </script>
{% endblock %}
