{% extends "_layout.njk" %}

{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/pagination/macro.njk" import govukPagination %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/input/macro.njk" import govukInput %}

{% if frn and schemeName %}
  {% set pageTitle = "Payment holds for " ~ schemeName ~ " and " ~ frn %}
{% elseif frn %}
  {% set pageTitle = "Payment holds for " ~ frn %}
{% elseif schemeName %}
  {% set pageTitle = "Payment holds for " ~ schemeName %}
{% else %}
  {% set pageTitle = "Payment holds" %}
{% endif %}

{% block pageTitle %}{{ pageTitle }} - {{ serviceName }}{% endblock %}

{% block beforeContent %}
  {{ govukBreadcrumbs({
    items: [{
      text: "Home",
      href: "/"
    },{
      text: "Manage payment holds",
      href: "/manage-payment-holds"
    },{
      text: "Search for a payment hold",
      href: "/search-payment-holds"
    }, {
      text: pageTitle
    }]
  })}}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      {% if holdRemoved %}
        <div class="govuk-notification-banner govuk-notification-banner--success" role="alert" aria-labelledby="govuk-notification-banner-title" data-module="govuk-notification-banner">
          <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title-hold-added">
              Success
            </h2>
          </div>
          <div class="govuk-notification-banner__content">
            <h3 class="govuk-notification-banner__heading">
              Payment hold for {{ frn }} | {{ holdCategoryName }} has been removed.
            </h3>
          </div>
        </div>
      {% endif %}

      <h1 class="govuk-heading-l">{{ pageTitle }}</h1>

      {% if paymentHolds.length %}
        {% if numberOfHolds == 1 %}
          {% set holdLabel = 'payment hold' %}
        {% else %}
          {% set holdLabel = 'payment holds' %}
        {% endif %}

        {% if frn and schemeName %}
          <p class="govuk-body">
            We’ve found {{ numberOfHolds }} {{ holdLabel }} for {{ schemeName }} and {{ frn }}.
          </p>
        {% elseif frn %}
          <p class="govuk-body">
            We’ve found {{ numberOfHolds }} {{ holdLabel }} for FRN {{ frn }}.
          </p>
        {% elseif schemeName %}
          <p class="govuk-body">
            We’ve found {{ numberOfHolds }} {{ holdLabel }} for {{ schemeName }}.
          </p>
        {% else %}
          <p class="govuk-body">
            We’ve found {{ numberOfHolds }} {{ holdLabel }}.
          </p>
        {% endif %}
        <div style="float: right;">
          <form action="/payment-holds" method="get">
            {{ govukSelect({
              id: "records",
              name: "perPage",
              label: {
                text: "Number of records per page"
              },
              attributes: {
                onchange: "this.form.submit()"
              },
              items: [
                {
                  value: 100,
                  text: "100",
                  selected: perPage == 100
                },
                {
                  value: 500,
                  text: "500",
                  selected: perPage == 500
                },
                {
                  value: 1000,
                  text: "1000",
                  selected: perPage == 1000
                }
              ]
            }) }}
          </form>
        </div>
        <div style="clear: both;"></div>

        <table class="govuk-table">
          <thead class="govuk-table__head">
            <tr class="govuk-table__row">
              <th scope="col" class="govuk-table__header">FRN</th>
              <th scope="col" class="govuk-table__header">Description</th>
              <th scope="col" class="govuk-table__header">Scheme</th>
              <th scope="col" class="govuk-table__header">Marketing Year</th>
              <th scope="col" class="govuk-table__header">Contract Number</th>
              <th scope="col" class="govuk-table__header">Agreement Number</th>
              <th scope="col" class="govuk-table__header">Created</th>
              <th scope="col" class="govuk-table__header">Actions</th>
            </tr>
          </thead>
          <tbody class="govuk-table__body">
            {% for paymentHold in paymentHolds %}
              <tr class="govuk-table__row">
                <td class="govuk-table__cell">{{ paymentHold.frn }}</td>
                <td class="govuk-table__cell">{{ paymentHold.holdCategoryName }}</td>
                <td class="govuk-table__cell">{{ paymentHold.holdCategorySchemeName }}</td>
                <td class="govuk-table__cell">{{ paymentHold.marketingYear }}</td>
                <td class="govuk-table__cell">{{ paymentHold.contractNumber }}</td>
                <td class="govuk-table__cell">{{ paymentHold.agreementNumber }}</td>
                <td class="govuk-table__cell">{{ paymentHold.dateTimeAdded }}</td>
                <td class="govuk-table__cell">
                  {% if paymentHold.canBeRemoved %}
                    <form method="post" action="/remove-payment-hold-confirm">
                      <input type="hidden" name="crumb" value="{{ crumb }}"/>
                      <input type="hidden" name="holdId" value="{{ paymentHold.holdId }}">
                      <input type="hidden" name="frn" value="{{ paymentHold.frn }}">
                      <input type="hidden" name="schemeName" value="{{ schemeName }}">
                      <input type="hidden" name="holdCategoryName" value="{{ paymentHold.holdCategoryName }}">
                      <button class="govuk-button-link">Remove</button>
                    </form>
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>

        <nav class="govuk-pagination" aria-label="Pagination">
          {% if (page | default(1)) > 1 %}
            <div class="govuk-pagination__prev">
              <a class="govuk-link govuk-pagination__link" href="?page={{ page - 1 }}&perPage={{ perPage }}" rel="prev">
                <svg class="govuk-pagination__icon govuk-pagination__icon--prev" xmlns="http://www.w3.org/2000/svg" height="13" width="15" aria-hidden="true" focusable="false" viewBox="0 0 15 13">
                  <path d="m6.5938-0.0078125-6.7266 6.7266 6.7441 6.4062 1.377-1.449-4.1856-3.9768h12.896v-2h-12.984l4.2931-4.293-1.414-1.414z"></path>
                </svg>
                <span class="govuk-pagination__link-title">
                  Previous<span class="govuk-visually-hidden"> page</span>
                </span>
              </a>
            </div>
          {% endif %}

          <ul class="govuk-pagination__list">
            <li class="govuk-pagination__item govuk-pagination__item--current">
              <span class="govuk-pagination__link-title">
                {{ page | default(1) }}
                <span class="govuk-visually-hidden"> page</span>
              </span>
            </li>
          </ul>

          {% if paymentHolds.length >= perPage %}
            <div class="govuk-pagination__next">
              <a class="govuk-link govuk-pagination__link" href="?page={{ (page | default(1)) + 1 }}&perPage={{ perPage }}" rel="next">
                <span class="govuk-pagination__link-title">
                  Next<span class="govuk-visually-hidden"> page</span>
                </span>
                <svg class="govuk-pagination__icon govuk-pagination__icon--next" xmlns="http://www.w3.org/2000/svg" height="13" width="15" aria-hidden="true" focusable="false" viewBox="0 0 15 13">
                  <path d="m8.107-0.0078125-1.4136 1.414 4.2926 4.293h-12.986v2h12.896l-4.1855 3.9766 1.377 1.4492 6.7441-6.4062-6.7246-6.7266z"></path>
                </svg>
              </a>
            </div>
          {% endif %}
        </nav>
      {% else %}
        <p class="govuk-body">
          {% if frn and schemeName %}
            No payment holds found for {{ schemeName }} and {{ frn }}. <a class="govuk-link" href="/search-payment-holds">Start a new search</a>.
          {% elseif frn %}
            No payment holds found for FRN {{ frn }}. <a class="govuk-link" href="/search-payment-holds">Start a new search</a>.
          {% elseif schemeName %}
            No payment holds found for {{ schemeName }}. <a class="govuk-link" href="/search-payment-holds">Start a new search</a>.
          {% else %}
            No payment holds found. <a class="govuk-link" href="/search-payment-holds">Start a new search</a>.
          {% endif %}
        </p>
      {% endif %}
    </div>
  </div>
{% endblock %}
