{% extends '_layout.njk' %}

{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}

{% set pageTitle = "Check the details are correct before creating a new closure agreement" %}

{% block pageTitle %}{{ pageTitle }} - {{ serviceName }}{% endblock %}

{% block beforeContent %}
  {{ govukBreadcrumbs({
    items: [{
      text: "Home",
      href: "/"
    }, {
      text: "Manage agreement closures",
      href: "/closure/manage"
    }, {
      text: "Create a new agreement closure",
      href: "/closure/add"
    }, {
      text: pageTitle
    }]
  })}}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h1 class="govuk-heading-l">{{ pageTitle }}</h1>

      <div class="govuk-summary-card">
        <div class="govuk-summary-card__title-wrapper">
          <h2 class="govuk-summary-card__title">
            Agreement closure
          </h2>
          <ul class="govuk-summary-card__actions">
            <li class="govuk-summary-card__action">
              <a class="govuk-link" href="/closure/add?frn={{ frn }}&agreement={{ agreement }}&schemeId={{ schemeId }}&day={{ day }}&month={{ month }}&year={{ year }}">Change<span class="govuk-visually-hidden"> agreement closure</span></a>
            </li>
          </ul>
        </div>
        <div class="govuk-summary-card__content">
          <dl class="govuk-summary-list">
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">
                FRN (Firm Reference Number)
              </dt>
              <dd class="govuk-summary-list__value">
                {{ frn }}
              </dd>
            </div>
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">
                Agreement number
              </dt>
              <dd class="govuk-summary-list__value">
                {{ agreement }}
              </dd>
            </div>
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">
                Scheme
              </dt>
              <dd class="govuk-summary-list__value">
                {{ schemeName }}
              </dd>
            </div>
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">
                Closure activation date
              </dt>
              <dd class="govuk-summary-list__value">
                {{ day }}/{{ month }}/{{ year }}
              </dd>
            </div>
          </dl>
        </div>
      </div>

      <form method="POST" action="/closure/add" autocomplete="off" novalidate>
        <input type="hidden" name="crumb" value="{{ crumb }}"/>
        <input type="hidden" name="frn" value="{{ frn }}"/>
        <input type="hidden" name="agreement" value="{{ agreement }}"/>
        <input type="hidden" name="schemeId" value="{{ schemeId }}"/>
        <input type="hidden" name="day" value="{{ day }}"/>
        <input type="hidden" name="month" value="{{ month }}"/>
        <input type="hidden" name="year" value="{{ year }}"/>
        <button class="govuk-button" id="submit">
          Add closure
        </button>
      </form>
    </div>
  </div>
{% endblock %}