{% extends '_layout.njk' %}

{% from 'macros/closure-breadcrumbs.njk' import closureBreadcrumbs %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from 'macros/records-per-page.njk' import recordsPerPage %}
{% from 'macros/build-pagination.njk' import buildPagination %}

{% set pageTitle = "Search agreement closures" %}
{% set hasMultiplePages = totalPages and totalPages > 1 %}

{% block pageTitle %}
  {% if hasMultiplePages %}
    Page {{ page }} - {{ pageTitle }} - {{ serviceName }}
  {% else %}
    {{ pageTitle }} - {{ serviceName }}
  {% endif %}
{% endblock %}

{% block beforeContent %}
  {{ closureBreadcrumbs(pageTitle) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      {% if closureRemoved %}
        <div
          class="govuk-notification-banner govuk-notification-banner--success"
          role="alert"
          aria-labelledby="govuk-notification-banner-title"
          data-module="govuk-notification-banner">
          <div class="govuk-notification-banner__header">
            <h2
              class="govuk-notification-banner__title"
              id="govuk-notification-banner-title">
              Success
            </h2>
          </div>
          <div class="govuk-notification-banner__content">
            <h3 class="govuk-notification-banner__heading">
              Agreement closure successfully removed.
            </h3>
          </div>
        </div>
      {% endif %}

      <h1 class="govuk-heading-l">{{ pageTitle }}</h1>

      <p class="govuk-body">
        Any agreements listed here are considered closed. This allows the
        Payment Hub to manage data retention for the data it holds related to
        payment requests.
      </p>
      <p class="govuk-body">
        Search for an agreement using the Firm Reference Number (FRN) or
        Agreement Number, and filter the results by scheme.
      </p>

      <form
        class="govuk-!-margin-bottom-6"
        action="/closure/search"
        method="GET"
        role="search">
        <h2 class="govuk-heading-m">Filter agreement closure results</h2>
        {{
          govukInput({
            label: {
              text: "FRN (Firm Reference Number) or Agreement Number"
            },
            id: "closure-search",
            name: "frnAgreement",
            type: "search",
            classes: "govuk-input--width-20",
            value: frnAgreement
          })
        }}

        <div class="govuk-form-group">
          <label
            class="govuk-label govuk-label-s"
            for="schemeId">
            Scheme
          </label>

          <select
            class="govuk-select"
            id="schemeId"
            name="schemeId">
            <option
              value=""
              {% if not schemeId %}selected{% endif %}>
              Search all schemes
            </option>

            {% for scheme in schemes %}
              {% if scheme and scheme.name is defined %}
                <option
                  value="{{ scheme.schemeId }}"
                  {% if scheme.schemeId == schemeId %}selected{% endif %}>
                  {{ scheme.name }}
                </option>
              {% endif %}
            {% endfor %}
          </select>
        </div>

        <input
          type="hidden"
          name="perPage"
          value="{{ perPage }}"
        />

        <div class="govuk-button-group">
          {{
            govukButton({
              text: "Filter",
              type: "submit"
            })
          }}
          <a
            class="govuk-link"
            href="/closure/search">Reset filter</a>
        </div>
      </form>

      {% if closures and closures.length %}
        <p class="govuk-body">
          We've found {{ count }} agreement closures
        </p>

        <p class="govuk-body">
          <a
            href="/closure/extract"
            class="govuk-link">Download all agreement closure data as CSV</a>
        </p>

        <div class="govuk-grid-row">
          <div class="govuk-grid-column-one-half">
            <h2 class="govuk-body">
              Showing {{ closures.length }} agreement closures
            </h2>
          </div>

          {% if hasMultiplePages %}
            <div class="govuk-grid-column-one-half govuk-!-padding-top-1">
              <div
                style="display:flex;align-items:baseline;justify-content:flex-end;">
                {{ recordsPerPage(perPage, [2500, 5000, 10000], extraQuery) }}
              </div>
            </div>
          {% endif %}
        </div>

        {% set tableRows = [] %}
        {% for closure in closures %}
          {% set removeButtonHtml %}
            <form
              method="GET"
              action="/closure/remove-confirm">
              <input
                type="hidden"
                name="retentionDataId"
                value="{{ closure.retentionDataId }}"
              />
              <input
                type="hidden"
                name="frn"
                value="{{ closure.frn }}"
              />
              <input
                type="hidden"
                name="agreementNumber"
                value="{{ closure.agreementNumber }}"
              />
              <input
                type="hidden"
                name="schemeName"
                value="{{ closure.schemeName }}"
              />
              <input
                type="hidden"
                name="page"
                value="{{ page }}"
              />
              <input
                type="hidden"
                name="perPage"
                value="{{ perPage }}"
              />
              <input
                type="hidden"
                name="frnAgreement"
                value="{{ frnAgreement or '' }}"
              />
              <input
                type="hidden"
                name="schemeId"
                value="{{ schemeId or '' }}"
              />
              <button
                class="govuk-button-link"
                aria-label="Remove closure for agreement {{ closure.agreementNumber }}">
                Remove
              </button>
            </form>
          {% endset %}

          {% set type = 'Manual' %}
          {% if closure.addedBy == 'DWH' %}
            {% set type = 'Auto' %}
          {% endif %}

          {%
            set tableRows = (tableRows.push([
              { text: closure.frn },
              { text: closure.agreementNumber },
              { text: closure.schemeName },
              { text: type },
              { text: closure.endDate },
              { html: removeButtonHtml }
            ]), tableRows)
          %}
        {% endfor %}

        {{
          govukTable({
            caption: "Agreement closures",
            captionClasses: "govuk-visually-hidden",
            firstCellIsHeader: false,
            head: [
              { text: "FRN" },
              { text: "Agreement" },
              { text: "Scheme" },
              { text: "Type" },
              { text: "Closure Date" },
              { text: "Actions" }
            ],
            rows: tableRows
          })
        }}

        {% if hasMultiplePages %}
          {{
            buildPagination(page, totalPages, perPage, extraQuery, paginationItems)
          }}
        {% endif %}
      {% else %}
        <div class="govuk-inset-text">
          {% if isSearch %}
            <p class="govuk-body">
              No agreement closures were found for{% if frnAgreement %}
                FRN / Agreement Number {{ frnAgreement }}{% endif %}
              {% if frnAgreement and schemeId %},{% endif %}
              {% if schemeId %}
                scheme {% for scheme in schemes %}{%
                    if scheme.schemeId == schemeId
                  %}{{ scheme.name }}{% endif %}{% endfor %}{% endif %}.
            </p>

            <p class="govuk-body">
              <a
                href="/closure/search"
                class="govuk-link">Clear search and view all agreement
                closures</a>.
            </p>
          {% else %}
            <p class="govuk-body">There are no agreement closures.</p>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
{% endblock %}
