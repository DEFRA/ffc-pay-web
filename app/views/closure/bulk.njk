{% extends '_layout.njk' %}

{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% set pageTitle = "Bulk add agreement closures" %}

{% block pageTitle %}{{ pageTitle }} - {{ serviceName }}{% endblock %}

{% block beforeContent %}
  {{ govukBreadcrumbs({
    items: [{
      text: "Home",
      href: "/"
    }, {
      text: "Manage agreement closures",
      href: "/closure/manage"
    },{
      text: pageTitle
    }]
  })}}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h1 class="govuk-heading-l">{{ pageTitle }}</h1>

      <p class="govuk-body">Bulk adding new agreement closures allows the Payment Hub to manage data retention for the data it holds related to payment requests.</p>
      <p class="govuk-body">For SFI22 only, any data supplied will be used for suppressions against the given Firm Reference Number (FRN) and agremeent number. If a '0' value payment request is received after the provided closure date, any amount repayable will be suppressed, and Dynamics 365 will be notified that the outstanding value should be reduced to ‘0’.</p>
      <p class="govuk-body">For guidance including how to format the csv file download the agreement closure guide (PDF).</p>

      <p class="govuk-body">Alternatively, you can <a href="/closure/bulk" class="govuk-link">create a singular agreement closure</a>.</p>

      {% if errors %}
        <div class="govuk-error-summary" aria-labelledby="error-summary-title" role="alert" tabindex="-1" data-module="govuk-error-summary">
          <div role="alert">
            <h2 class="govuk-error-summary__title" id="error-summary-title">There is a problem</h2>
            <div class="govuk-error-summary__body">
              <ul class="govuk-list govuk-error-summary__list">
                {% for err in errors.details %}
                  <li><a href="#{{ err.path[0] or err.context.key }}">{{ err.message }}</a></li>
                {% endfor %}
              </ul>
            </div>
          </div>
        </div>

        {# Build per-field error variables from errors.details #}
        {% set fileError = null %}
        {% for err in errors.details %}
          {% set field = (err.path and err.path[0]) or (err.context and err.context.key) %}
          {% if field == 'file' %}{% set fileError = err.message %}{% endif %}
        {% endfor %}

      {% endif %}

      <form method="POST" action="/closure/bulk" autocomplete="off" novalidate enctype="multipart/form-data">
        <input type="hidden" name="crumb" value="{{crumb}}"/>

        <div class="govuk-form-group {% if fileError %}govuk-form-group--error{% endif %}">
          <label class="govuk-label govuk-label-s" for="file">
            Upload a file
          </label>
          {% if fileError %}
            <p id="file-error" class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> {{ fileError }}</p>
          {% endif %}
          <input class="govuk-file-upload {% if fileError %}govuk-file-upload--error{% endif %}" id="file" name="file" type="file" value="{{ file }}" {% if fileError %}aria-describedby="file-error"{% endif %}>
        </div>
        
        {{ govukButton({
          text: "Add closures",
          attributes: {
            id: "submit"
          }
        }) }}
      </form>
    </div>
  </div>
{% endblock %}
