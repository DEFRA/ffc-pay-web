{% extends 'generate-report-list/base-report.njk' %}
{% from 'macros/report-form-fields.njk' import reportPageTitle, schemeSelect, yearInput, revenueOrCapitalSelect, frnInput, submitButton, prnInput %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% set reportTitle = 'Payment request statuses report' %}
{% set reportUrl = '/generate-report-list/generate-payment-request-statuses' %}
{% set formAction = '/generate-report-list/generate-payment-request-statuses/download' %}

{% block reportContent %}
    {{ reportPageTitle(reportTitle) }}
    {{ schemeSelect(schemes, selectedSchemeId) }}
    {{ yearInput(year) }}
    {{ prnInput(prn) }}
    {{ revenueOrCapitalSelect(revenueOrCapital) }}
    {{ frnInput(frn) }}
{% endblock %}
