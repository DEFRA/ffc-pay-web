{% extends '_layout.njk' %}

{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}
{% from "govuk/components/pagination/macro.njk" import govukPagination %}

{% set pageTitle = "Statement search results" %}
{% set itemLimit = limit or 2500 %}
{%
  set totalPages = (totalCount / itemLimit) | round(0, 'ceil') if totalCount else 0
%}
{% set hasMultiplePages = totalPages > 1 %}

{% set extraQuery = '' %}
{% if schemeId %}
  {% set extraQuery = extraQuery + '&schemeId=' + schemeId %}
{% endif %}
{% if marketingYear %}
  {% set extraQuery = extraQuery + '&marketingYear=' + marketingYear %}
{% endif %}
{% if frn %}
  {% set extraQuery = extraQuery + '&frn=' + frn %}
{% endif %}
{% if filename %}
  {% set extraQuery = extraQuery + '&filename=' + filename %}
{% endif %}
{% if timestamp %}
  {% set extraQuery = extraQuery + '&timestamp=' + timestamp %}
{% endif %}

{% block pageTitle %}
  {% if hasMultiplePages %}
    Page {{ pageNumber }} - {{ pageTitle }} - {{ serviceName }}
  {% else %}
    {{ pageTitle }} - {{ serviceName }}
  {% endif %}
{% endblock %}

{% block beforeContent %}
  {{
    govukBreadcrumbs({
      items: [
        { text: "Home", href: "/" },
        { text: "Download payment statements", href: "/download-statements" },
        { text: "Statements" }
      ]
    })
  }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h1 class="govuk-heading-l">{{ pageTitle }}</h1>
    </div>
  </div>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if error %}
        {{
          govukErrorSummary({
            titleText: "There is a problem",
            errorList: [{ text: error.message }]
          })
        }}
      {% endif %}

      {% if totalCount %}
        <p class="govuk-body">
          Download and view statements matching your search criteria, or
          <a
            href="/download-statements"
            class="govuk-link">start a new search</a>.
        </p>
      {% endif %}

      {% if statements and statements.length > 0 %}
        {% if totalCount %}
          <p class="govuk-body">
            We've found {{ totalCount }} statement{{ 's' if totalCount != 1 }}.
          </p>
        {% endif %}

        <h2 class="govuk-heading-m">Statements</h2>

        <div class="govuk-grid-row govuk-!-margin-bottom-3">
          <div class="govuk-grid-column-one-half">
            <p
              class="govuk-body-m govuk-!-margin-0"
              id="statement-count">
              Showing {{ statements.length }} statement{{
                's' if statements.length != 1
              }}
            </p>
          </div>

          {% if hasMultiplePages %}
            <div class="govuk-grid-column-one-half">
              <div
                style="display:flex;align-items:baseline;justify-content:flex-end;">
                <div
                  class="govuk-body-s govuk-!-margin-0"
                  aria-label="Records per page"
                  style="white-space:nowrap;vertical-align:baseline;">
                  <span>Number of records per page:</span>&nbsp;
                  {% set perPageOptions = [2500, 5000, 10000] %}
                  {% for opt in perPageOptions %}
                    {% if itemLimit == opt %}
                      <strong>{{ opt }}</strong>
                    {% else %}
                      <a
                        class="govuk-link"
                        href="?limit={{ opt }}&pageNumber=0{{ extraQuery }}">{{
                        opt
                      }}</a>
                    {% endif %}
                    {% if not loop.last %}
                      &nbsp;|&nbsp;
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
            </div>
          {% endif %}
        </div>

        <table class="govuk-table">
          <caption class="govuk-visually-hidden">
            Search results for payment statements
          </caption>
          <thead class="govuk-table__head">
            <tr class="govuk-table__row">
              <th
                scope="col"
                class="govuk-table__header">
                Scheme
              </th>
              <th
                scope="col"
                class="govuk-table__header">
                Year
              </th>
              <th
                scope="col"
                class="govuk-table__header">
                FRN
              </th>
              <th
                scope="col"
                class="govuk-table__header">
                Timestamp
              </th>
              <th
                scope="col"
                class="govuk-table__header">
                Action
              </th>
            </tr>
          </thead>
          <tbody class="govuk-table__body">
            {% for statement in statements %}
              <tr class="govuk-table__row">
                <td class="govuk-table__cell">{{ statement.scheme }}</td>
                <td class="govuk-table__cell">{{ statement.year }}</td>
                <td class="govuk-table__cell">{{ statement.frn }}</td>
                <td class="govuk-table__cell">{{ statement.timestamp }}</td>
                <td class="govuk-table__cell">
                  {% if statement.filename %}
                    <a
                      href="/download-statements/download/{{ statement.filename }}"
                      class="govuk-link">
                      Download
                      <span class="govuk-visually-hidden">
                        statement for {{ statement.scheme }} {{
                          statement.year
                        }}
                        FRN {{ statement.frn }}
                      </span>
                    </a>
                  {% else %}
                    <span class="govuk-body-s">File unavailable</span>
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>

        {% if totalCount %}
          <form
            id="pagination-form"
            method="GET"
            action="/statement-results"
            style="display: none;">
            <input
              type="hidden"
              name="schemeId"
              value="{{ schemeId }}"
            />
            <input
              type="hidden"
              name="marketingYear"
              value="{{ marketingYear }}"
            />
            <input
              type="hidden"
              name="frn"
              value="{{ frn }}"
            />
            <input
              type="hidden"
              name="filename"
              value="{{ filename }}"
            />
            <input
              type="hidden"
              name="timestamp"
              value="{{ timestamp }}"
            />
            <input
              type="hidden"
              name="limit"
              value="{{ itemLimit }}"
            />
            <input
              type="hidden"
              name="pageNumber"
              id="pagination-page-number"
              value="0"
            />
            {% if continuationToken %}
              <input
                type="hidden"
                name="continuationToken"
                value="{{ continuationToken }}"
              />
            {% endif %}
          </form>

          {% set paginationItems = [] %}
          {% set rangePageStart = pageNumber - 1 %}
          {% set rangePageEnd = pageNumber + 1 %}

          {% for i in range(1, totalPages + 1) %}
            {% set pageIndex = i - 1 %}
            {%
              set clickAttributes = {
                'onclick': "document.getElementById('pagination-page-number').value = " ~ pageIndex ~ "; document.getElementById('pagination-form').submit(); return false;"
              }
            %}

            {%
              if i == 1 or i == totalPages or (i >= rangePageStart and i <= rangePageEnd)
            %}
              {%
                set _ = paginationItems.push({
                  number: i,
                  href: '#',
                  current: (i === pageNumber),
                  attributes: clickAttributes
                })
              %}
            {% elif i == 2 and rangePageStart > 3 %}
              {% set _ = paginationItems.push({ ellipsis: true }) %}
            {% elif i == totalPages - 1 and rangePageEnd < totalPages - 1 %}
              {% set _ = paginationItems.push({ ellipsis: true }) %}
            {% endif %}
          {% endfor %}

          {% set paginationPrevious = undefined %}
          {% set paginationNext = undefined %}

          {% if pageNumber > 1 %}
            {%
              set paginationPrevious = {
                href: '#',
                labelText: 'Previous page',
                attributes: {
                  'onclick': "document.getElementById('pagination-page-number').value = " ~ (pageNumber - 2) ~ "; document.getElementById('pagination-form').submit(); return false;"
                }
              }
            %}
          {% endif %}

          {% if pageNumber < totalPages %}
            {%
              set paginationNext = {
                href: '#',
                labelText: 'Next page',
                attributes: {
                  'onclick': "document.getElementById('pagination-page-number').value = " ~ pageNumber ~ "; document.getElementById('pagination-form').submit(); return false;"
                }
              }
            %}
          {% endif %}

          {% if hasMultiplePages %}
            {{
              govukPagination({
                previous: paginationPrevious,
                next: paginationNext,
                items: paginationItems
              })
            }}
          {% endif %}
        {% endif %}
      {% else %}
        <p class="govuk-body">
          No statements were found for the entered search criteria.
        </p>
        <p class="govuk-body">
          Return to
          <a
            href="/download-statements"
            class="govuk-link">download statements</a>
          and try again.
        </p>
      {% endif %}
    </div>
  </div>
{% endblock %}
