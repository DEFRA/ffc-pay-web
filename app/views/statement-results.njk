{% extends '_layout.njk' %}

{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}
{% from "govuk/components/pagination/macro.njk" import govukPagination %}

{% set pageTitle = "Statement search results" %}

{% block pageTitle %}{{ pageTitle }} - {{ serviceName }}{% endblock %}

{% block beforeContent %}
  {{ govukBreadcrumbs({
    items: [
      { text: "Home", href: "/" },
      { text: "Download payment statements", href: "/download-statements" },
      { text: "Statements" }
    ]
  })}}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h1 class="govuk-heading-l">{{ pageTitle }}</h1>
    </div>
  </div>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if error %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: [{ text: error.message }]
        }) }}
      {% endif %}

    {% if totalCount %}
    <p class="govuk-body">
        Download and view statements matching your search criteria, or <a href="/download-statements">start a new search.</a>
    </p>
    {% endif %}

      {% if statements and statements.length > 0 %}
        {% set resultCount = statements.length %}
        {% set itemLimit = limit or 100 %}
        {% set startItem = ((pageNumber - 1) * itemLimit) + 1 %}
        {% set endItem = startItem + resultCount - 1 %}

        <div class="govuk-grid-row govuk-!-margin-bottom-4">
          <div class="govuk-grid-column-full govuk-!-text-align-right">
            <form id="limit-form" method="GET" action="/statement-results" style="display: inline;">
              <input type="hidden" name="schemeId" value="{{ schemeId }}"/>
              <input type="hidden" name="marketingYear" value="{{ marketingYear }}"/>
              <input type="hidden" name="frn" value="{{ frn }}"/>
              <input type="hidden" name="filename" value="{{ filename }}"/>
              <input type="hidden" name="timestamp" value="{{ timestamp }}"/>
              <input type="hidden" name="pageNumber" value="0"/>
              <label class="govuk-label govuk-!-display-inline-block govuk-!-margin-right-2 govuk-!-margin-bottom-0" for="limit-select">Results per page</label>
              <select class="govuk-select" id="limit-select" name="limit" onchange="this.form.submit();">
                {% for opt in [100, 250, 500, 1000] %}
                  <option value="{{ opt }}" {% if itemLimit == opt %}selected{% endif %}>{{ opt }}</option>
                {% endfor %}
              </select>
            </form>
          </div>
        </div>

        {% if totalCount %}
          <div class="govuk-grid-row govuk-!-margin-bottom-4">
            <div class="govuk-grid-column-one-half">
              <p class="govuk-body govuk-!-margin-bottom-0">
                <h2 class="govuk-heading-m govuk-!-margin-bottom-0">[{{ totalCount }}]   Statements</h2>
              </p>
            </div>
          </div>
        {% endif %}

        <table class="govuk-table">
          <caption class="govuk-visually-hidden">Search results for payment statements</caption>
          <thead class="govuk-table__head">
            <tr class="govuk-table__row">
              <th scope="col" class="govuk-table__header">Scheme</th>
              <th scope="col" class="govuk-table__header">Year</th>
              <th scope="col" class="govuk-table__header">FRN</th>
              <th scope="col" class="govuk-table__header">Timestamp</th>
              <th scope="col" class="govuk-table__header">Action</th>
            </tr>
          </thead>
          <tbody class="govuk-table__body">
            {% for statement in statements %}
              <tr class="govuk-table__row">
                <td class="govuk-table__cell">{{ statement.scheme }}</td>
                <td class="govuk-table__cell">{{ statement.year }}</td>
                <td class="govuk-table__cell">{{ statement.frn }}</td>
                <td class="govuk-table__cell">{{ statement.timestamp }}</td>
                <td class="govuk-table__cell">
                  {% if statement.filename %}
                    <a href="/download-statements/download/{{ statement.filename }}" class="govuk-link">
                      Download <span class="govuk-visually-hidden">statement for {{ statement.scheme }} {{ statement.year }} FRN {{ statement.frn }}</span>
                    </a>
                  {% else %}
                    <span class="govuk-body-s">File unavailable</span>
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>

        {% if totalCount %}
          <form id="pagination-form" method="GET" action="/statement-results" style="display: none;">
            <input type="hidden" name="schemeId" value="{{ schemeId }}"/>
            <input type="hidden" name="marketingYear" value="{{ marketingYear }}"/>
            <input type="hidden" name="frn" value="{{ frn }}"/>
            <input type="hidden" name="filename" value="{{ filename }}"/>
            <input type="hidden" name="timestamp" value="{{ timestamp }}"/>
            <input type="hidden" name="limit" value="{{ itemLimit }}"/>
            <input type="hidden" name="pageNumber" id="pagination-page-number" value="0"/>
            {% if continuationToken %}
              <input type="hidden" name="continuationToken" value="{{ continuationToken }}"/>
            {% endif %}
          </form>

        {% if totalCount %}
        {% set totalPages = (totalCount / itemLimit) | round(0, 'ceil') %}
        {% set paginationItems = [] %}        
        {% set rangePageStart = pageNumber - 1 %}
        {% set rangePageEnd = pageNumber + 1 %}

        {% for i in range(1, totalPages + 1) %}
            {% set pageIndex = i - 1 %}
            {% set clickAttributes = { 'onclick': "document.getElementById('pagination-page-number').value = " ~ pageIndex ~ "; document.getElementById('pagination-form').submit(); return false;" } %}

            {% if i == 1 or i == totalPages or (i >= rangePageStart and i <= rangePageEnd) %}
            {% set _ = paginationItems.push({
                number: i,
                href: '#',
                current: (i === pageNumber),
                attributes: clickAttributes
            }) %}
            {% elif i == 2 and rangePageStart > 2 %}
            {% set _ = paginationItems.push({ ellipsis: true }) %}
            {% elif i == totalPages - 1 and rangePageEnd < totalPages - 1 %}
            {% set _ = paginationItems.push({ ellipsis: true }) %}
            
            {% endif %}
        {% endfor %}
        {% set prevConfig = false %}
        {% if pageNumber > 1 %}
            {% set prevConfig = {
            href: '#',
            attributes: { 'onclick': "document.getElementById('pagination-page-number').value = " ~ (pageNumber - 2) ~ "; document.getElementById('pagination-form').submit(); return false;" }
            } %}
        {% endif %}
        {% set nextConfig = false %}
        {% if pageNumber < totalPages %}
            {% set nextConfig = {
            href: '#',
            attributes: { 'onclick': "document.getElementById('pagination-page-number').value = " ~ pageNumber ~ "; document.getElementById('pagination-form').submit(); return false;" }
            } %}
        {% endif %}
        {{ govukPagination({
            previous: prevConfig if prevConfig else undefined,
            next: nextConfig if nextConfig else undefined,
            items: paginationItems
        }) }}

        {% elif continuationToken %}
        {% set prevAttrs = {'onclick': "document.getElementById('pagination-page-number').value = " ~ (pageNumber - 2) ~ "; document.getElementById('pagination-form').submit(); return false;"} %}
        {% set nextAttrs = {'onclick': "document.getElementById('pagination-page-number').value = " ~ pageNumber ~ "; document.getElementById('pagination-form').submit(); return false;"} %}

        {% if pageNumber > 1 and continuationToken %}
            {{ govukPagination({ previous: { href: '#', attributes: prevAttrs }, next: { href: '#', attributes: nextAttrs } }) }}
        {% elif pageNumber > 1 %}
            {{ govukPagination({ previous: { href: '#', attributes: prevAttrs } }) }}
        {% else %}
            {{ govukPagination({ next: { href: '#', attributes: nextAttrs } }) }}
        {% endif %}
        {% endif %}
        {% endif %}
      {% else %}
        <p class="govuk-body">No statements were found for the entered search criteria.</p>
        <p class="govuk-body">Return to '<a href="/download-statements">download-statements</a>' and try again.</p>
      {% endif %}
    </div>
  </div>
{% endblock %}
