{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% macro holdTypeForm(params) %}
  <form
    method="POST"
    action="{{ params.action }}"
    autocomplete="off"
    novalidate>
    <input
      type="hidden"
      name="crumb"
      value="{{ params.crumb }}"
    />
    {% if params.holdCategoryId %}
      <input
        type="hidden"
        name="holdCategoryId"
        value="{{ params.holdCategoryId }}"
      />
    {% endif %}

    <h1 class="govuk-heading-l">{{ params.pageTitle }}</h1>

    {% if params.paragraphText %}
      <p class="govuk-body">{{ params.paragraphText }}</p>
    {% endif %}

    {% set schemeIdError = null %}
    {% set categoryNameError = null %}
    {% if params.errors %}
      {% for errorDetail in params.errors.details %}
        {% if errorDetail.path[0] == "schemeId" %}
          {% set schemeIdError = { text: errorDetail.message } %}
        {% elif errorDetail.path[0] == "categoryName" %}
          {% set categoryNameError = { text: errorDetail.message } %}
        {% endif %}
      {% endfor %}
    {% endif %}

    {% if params.errors %}
      {% set errorList = [] %}
      {% for errorDetail in params.errors.details %}
        {% set errorHref = "#" %}
        {% if errorDetail.path[0] == "schemeId" %}
          {% set errorHref = "#schemeId" %}
        {% elif errorDetail.path[0] == "categoryName" %}
          {% set errorHref = "#categoryName" %}
        {% endif %}
        {%
          set errorList = (errorList.push({
            text: errorDetail.message,
            href: errorHref
          }), errorList)
        %}
      {% endfor %}

      {{
        govukErrorSummary({
          titleText: "There is a problem",
          errorList: errorList
        })
      }}
    {% endif %}

    {% if params.showSchemeSelect %}
      <div
        class="govuk-form-group{% if schemeIdError %} govuk-form-group--error{% endif %}">
        <label
          class="govuk-label"
          for="schemeId">Scheme</label>
        {% if schemeIdError %}
          <p
            id="schemeId-error"
            class="govuk-error-message">
            <span class="govuk-visually-hidden">Error:</span> {{
              schemeIdError.text
            }}
          </p>
        {% endif %}
        <select
          class="govuk-select{% if schemeIdError %} govuk-select--error{% endif %}"
          id="schemeId"
          name="schemeId"
          {% if schemeIdError %}aria-describedby="schemeId-error"{% endif %}>
          <option
            value=""
            {% if not schemeId %}selected{% endif %}>
            Select a scheme
          </option>
          {% for scheme in params.schemes %}
            <option
              value="{{ scheme.schemeId }}"
              {% if scheme.schemeId == params.selectedSchemeId %}
                selected
              {% endif %}>
              {{ scheme.name }}
            </option>
          {% endfor %}
        </select>
      </div>
    {% endif %}

    <div
      class="govuk-form-group{% if categoryNameError %} govuk-form-group--error{% endif %}">
      <label
        class="govuk-label"
        for="categoryName">Payment hold type name</label>
      {% if categoryNameError %}
        <p
          id="categoryName-error"
          class="govuk-error-message">
          <span class="govuk-visually-hidden">Error:</span> {{
            categoryNameError.text
          }}
        </p>
      {% endif %}
      <input
        class="govuk-input{% if categoryNameError %} govuk-input--error{% endif %}"
        id="categoryName"
        name="categoryName"
        type="text"
        value="{{ params.categoryName }}"
        {% if categoryNameError %}
          aria-describedby="categoryName-error"
        {% endif %}
      />
    </div>

    <div class="govuk-button-group">
      {{
        govukButton({
          text: params.submitText or "Save",
          attributes: { id: "submit" }
        })
      }}
      <a
        class="govuk-link"
        href="{{ params.cancelHref or '/payment-holds/types' }}">Cancel</a>
    </div>
  </form>
{% endmacro %}
