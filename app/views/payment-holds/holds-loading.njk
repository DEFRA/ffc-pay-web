{% extends "_layout.njk" %}

{% from "macros/loading.njk" import renderLoadingPage %}
{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}

{% set pageTitle = "Processing bulk upload" %}

{% block pageTitle %}{{ pageTitle }} - {{ serviceName }}{% endblock %}

{% block beforeContent %}
  {{
    govukBreadcrumbs({
      items: [{
        text: "Home",
        href: "/"
      },{
        text: "Manage payment holds",
        href: "/payment-holds/manage"
      },{
        text: "Manage payment holds in bulk",
        href: "/payment-holds/bulk-manage"
      }, {
        text: (type | capitalize) ~ ' payment holds in bulk',
        href: "/payment-holds/bulk"
      }, {
        text: pageTitle
      }]
    })
  }}
{% endblock %}

{% block content %}
  {{
    renderLoadingPage(
      jobId=jobId,
      checkUrl="/loading/" + jobId,
      redirectUrl="/payment-holds/bulk-manage?bulk=" + type,
      title=pageTitle,
      statusMessage="We're processing your payment holds. This can take a few minutes for large files.",
      completedMessage="Your payment holds have been successfully processed. You will be redirected to the payment holds page.",
      errorMessage="We were unable to process your payment holds. Please try again."
    )
  }}
{% endblock %}
