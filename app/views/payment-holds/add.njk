{% extends '_layout.njk' %}

{% from 'macros/hold-breadcrumbs.njk' import holdBreadcrumbs %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from 'macros/hold-selection-radios.njk' import holdSelectionRadios %}

{% set pageTitle = "Create a payment hold" %}

{% block pageTitle %}{{ pageTitle }} - {{ serviceName }}{% endblock %}

{% block beforeContent %}
  {{ holdBreadcrumbs(pageTitle) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <form
        method="POST"
        action="/payment-holds/add-confirm"
        autocomplete="off"
        novalidate>
        <input
          type="hidden"
          name="crumb"
          value="{{ crumb }}"
        />

        {% if errors %}
          {% set errorList = [] %}
          {% for errorDetail in errors.details %}
            {% set errorHref = "#" %}
            {% if errorDetail.path[0] == "frn" %}
              {% set errorHref = "#frn" %}
            {% elif errorDetail.path[0] == "selectScheme" %}
              {% set errorHref = "#selectScheme" %}
            {% elif errorDetail.path[0] == "holdCategoryId" %}
              {% set errorHref = "#selectHoldCategoryId" %}
            {% endif %}
            {%
              if errorDetail.path[0] != "holdCategoryId" or selectScheme or not (holdCategoryRadios and holdCategoryRadios.length > 0)
            %}
              {%
                set errorList = (errorList.push({
                  text: errorDetail.message,
                  href: errorHref
                }), errorList)
              %}
            {% endif %}
          {% endfor %}

          {{
            govukErrorSummary({
              titleText: "There is a problem",
              errorList: errorList
            })
          }}
        {% endif %}

        {% set frnError = null %}
        {% set schemeError = null %}
        {% set holdCategoryError = null %}
        {% if errors %}
          {% for errorDetail in errors.details %}
            {% if errorDetail.path[0] == "frn" %}
              {% set frnError = { text: errorDetail.message } %}
            {% elif errorDetail.path[0] == "selectScheme" %}
              {% set schemeError = { text: errorDetail.message } %}
            {%
              elif errorDetail.path[0] == "holdCategoryId" and (selectScheme or not (holdCategoryRadios and holdCategoryRadios.length > 0))
            %}
              {% set holdCategoryError = { text: errorDetail.message } %}
            {% endif %}
          {% endfor %}
        {% endif %}

        <h1 class="govuk-heading-l">{{ pageTitle }}</h1>

        <p class="govuk-body">
          To create a new payment hold enter the 10 digit Firm Reference Number
          (FRN), select the scheme and the hold type.
        </p>

        <p class="govuk-body">
          If you want to add more than one hold, you can <a
            href="/payment-holds/bulk"
            class="govuk-link">bulk add holds</a>.
        </p>

        {{
          govukInput({
            label: {
              text: "FRN (Firm Reference Number)",
              classes: "govuk-label--s"
            },
            id: "frn",
            name: "frn",
            value: frn,
            classes: "govuk-input--width-10",
            errorMessage: frnError,
            inputmode: "numeric",
            spellcheck: false
          })
        }}

        {{
          holdSelectionRadios(holdCategoryRadios, selectScheme, selectHoldCategoryId, schemeError, holdCategoryError)
        }}

        <div class="govuk-button-group">
          {{
            govukButton({
              text: "Continue",
              attributes: {
                id: "submit"
              }
            })
          }}
          <a
            class="govuk-link"
            href="/payment-holds/manage">Cancel</a>
        </div>
      </form>
    </div>
  </div>
{% endblock %}
