{% extends "_layout.njk" %}

{%
  from "macros/hold-breadcrumbs-with-search.njk" import holdBreadcrumbsWithSearch
%}
{% from "govuk/components/pagination/macro.njk" import govukPagination %}

{% if frn and schemeName %}
  {% set pageTitle = "Payment holds for " ~ schemeName ~ " and " ~ frn %}
{% elseif frn %}
  {% set pageTitle = "Payment holds for " ~ frn %}
{% elseif schemeName %}
  {% set pageTitle = "Payment holds for " ~ schemeName %}
{% else %}
  {% set pageTitle = "Payment holds" %}
{% endif %}

{% set hasMultiplePages = totalPages and totalPages > 1 %}

{% block pageTitle %}
  {% if hasMultiplePages %}
    Page {{ page }} - {{ pageTitle }} - {{ serviceName }}
  {% else %}
    {{ pageTitle }} - {{ serviceName }}
  {% endif %}
{% endblock %}

{% block beforeContent %}
  {{ holdBreadcrumbsWithSearch(pageTitle) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      {% if holdRemoved %}
        <div
          class="govuk-notification-banner govuk-notification-banner--success"
          role="alert"
          aria-labelledby="govuk-notification-banner-title"
          data-module="govuk-notification-banner">
          <div class="govuk-notification-banner__header">
            <h2
              class="govuk-notification-banner__title"
              id="govuk-notification-banner-title">
              Success
            </h2>
          </div>
          <div class="govuk-notification-banner__content">
            <h3 class="govuk-notification-banner__heading">
              Payment hold for {{ frn }} | {{ holdCategoryName }} has been
              removed.
            </h3>
          </div>
        </div>
      {% endif %}

      <h1 class="govuk-heading-l">{{ pageTitle }}</h1>

      {% if paymentHolds.length %}
        {% if numberOfHolds == 1 %}
          {% set holdLabel = "payment hold" %}
        {% else %}
          {% set holdLabel = "payment holds" %}
        {% endif %}

        {% if frn and schemeName %}
          <p class="govuk-body">
            We’ve found {{ numberOfHolds }} {{ holdLabel }} for {{
              schemeName
            }}
            and {{ frn }}.
          </p>
        {% elseif frn %}
          <p class="govuk-body">
            We’ve found {{ numberOfHolds }} {{ holdLabel }} for FRN {{ frn }}.
          </p>
        {% elseif schemeName %}
          <p class="govuk-body">
            We’ve found {{ numberOfHolds }} {{ holdLabel }} for {{
              schemeName
            }}.
          </p>
        {% else %}
          <p class="govuk-body">
            We’ve found {{ numberOfHolds }} {{ holdLabel }}.
          </p>
        {% endif %}

        <div class="govuk-grid-row">
          <div class="govuk-grid-column-one-half">
            <h2 class="govuk-heading-m govuk-!-margin-0">Payment holds</h2>
          </div>

          {% if hasMultiplePages %}
            <div class="govuk-grid-column-one-half govuk-!-padding-top-1">
              <div
                style="display:flex;align-items:baseline;justify-content:flex-end;">
                <div
                  class="govuk-body-s"
                  aria-label="Records per page"
                  style="white-space:nowrap;vertical-align:baseline;">
                  <span>Number of records per page:</span>&nbsp;
                  {% set perPageOptions = [100, 500, 1000] %}
                  {% for opt in perPageOptions %}
                    {% if perPage == opt %}
                      <strong>{{ opt }}</strong>
                    {% else %}
                      <a
                        href="?perPage={{ opt }}&page=1{{ extraQuery }}"
                        class="govuk-link">{{ opt }}</a>
                    {% endif %}
                    {% if not loop.last %}
                      &nbsp;|&nbsp;
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
            </div>
          {% endif %}
        </div>

        <p
          class="govuk-body-m"
          id="payment-hold-count">
          Showing {{ paymentHolds.length }} payment hold{{
            's' if paymentHolds.length != 1
          }}
        </p>

        <table class="govuk-table">
          <thead class="govuk-table__head">
            <tr class="govuk-table__row">
              <th
                scope="col"
                class="govuk-table__header">
                FRN
              </th>
              <th
                scope="col"
                class="govuk-table__header">
                Description
              </th>
              <th
                scope="col"
                class="govuk-table__header">
                Scheme
              </th>
              <th
                scope="col"
                class="govuk-table__header">
                Marketing Year
              </th>
              <th
                scope="col"
                class="govuk-table__header">
                Contract Number
              </th>
              <th
                scope="col"
                class="govuk-table__header">
                Agreement Number
              </th>
              <th
                scope="col"
                class="govuk-table__header">
                Created
              </th>
              <th
                scope="col"
                class="govuk-table__header">
                Actions
              </th>
            </tr>
          </thead>
          <tbody class="govuk-table__body">
            {% for paymentHold in paymentHolds %}
              <tr class="govuk-table__row">
                <td class="govuk-table__cell">{{ paymentHold.frn }}</td>
                <td class="govuk-table__cell">
                  {{ paymentHold.holdCategoryName }}
                </td>
                <td class="govuk-table__cell">
                  {{ paymentHold.holdCategorySchemeName }}
                </td>
                <td class="govuk-table__cell">
                  {{ paymentHold.marketingYear }}
                </td>
                <td class="govuk-table__cell">
                  {{ paymentHold.contractNumber }}
                </td>
                <td class="govuk-table__cell">
                  {{ paymentHold.agreementNumber }}
                </td>
                <td class="govuk-table__cell">
                  {{ paymentHold.dateTimeAdded }}
                </td>
                <td class="govuk-table__cell">
                  {% if paymentHold.canBeRemoved %}
                    <form
                      method="post"
                      action="/payment-holds/remove-confirm">
                      <input
                        type="hidden"
                        name="crumb"
                        value="{{ crumb }}"
                      />
                      <input
                        type="hidden"
                        name="holdId"
                        value="{{ paymentHold.holdId }}"
                      />
                      <input
                        type="hidden"
                        name="frn"
                        value="{{ paymentHold.frn }}"
                      />
                      <input
                        type="hidden"
                        name="schemeName"
                        value="{{ schemeName }}"
                      />
                      <input
                        type="hidden"
                        name="holdCategoryName"
                        value="{{ paymentHold.holdCategoryName }}"
                      />
                      <input
                        type="hidden"
                        name="page"
                        value="{{ page }}"
                      />
                      <input
                        type="hidden"
                        name="perPage"
                        value="{{ perPage }}"
                      />
                      <button class="govuk-button-link">Remove</button>
                    </form>
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>

        {% if hasMultiplePages %}
          {% set paginationPrevious = undefined %}
          {% set paginationNext = undefined %}

          {% if page > 1 %}
            {%
              set paginationPrevious = {
                href: "?page=" + (page - 1) + "&perPage=" + perPage + extraQuery,
                labelText: "Previous page"
              }
            %}
          {% endif %}

          {% if page < totalPages %}
            {%
              set paginationNext = {
                href: "?page=" + (page + 1) + "&perPage=" + perPage + extraQuery,
                labelText: "Next page"
              }
            %}
          {% endif %}

          {{
            govukPagination({
              previous: paginationPrevious,
              next: paginationNext,
              items: paginationItems
            })
          }}
        {% endif %}
      {% else %}
        <p class="govuk-body">
          {% if frn and schemeName %}
            No payment holds found for {{ schemeName }} and {{ frn }}.
          {% elseif frn %}
            No payment holds found for FRN {{ frn }}.
          {% elseif schemeName %}
            No payment holds found for {{ schemeName }}.
          {% else %}
            No payment holds found.
          {% endif %}
          <a
            class="govuk-link"
            href="/payment-holds/search">Start a new search</a>.
        </p>
      {% endif %}
    </div>
  </div>
{% endblock %}
