{% extends "_layout.njk" %}

{%
  from 'macros/hold-breadcrumbs-with-search.njk' import holdBreadcrumbsWithSearch
%}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/pagination/macro.njk" import govukPagination %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/input/macro.njk" import govukInput %}

{% if frn and schemeName %}
  {% set pageTitle = "Payment holds for " ~ schemeName ~ " and " ~ frn %}
{% elseif frn %}
  {% set pageTitle = "Payment holds for " ~ frn %}
{% elseif schemeName %}
  {% set pageTitle = "Payment holds for " ~ schemeName %}
{% else %}
  {% set pageTitle = "Payment holds" %}
{% endif %}

{% block pageTitle %}{{ pageTitle }} - {{ serviceName }}{% endblock %}

{% block beforeContent %}
  {{ holdBreadcrumbsWithSearch(pageTitle) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      {% if holdRemoved %}
        <div
          class="govuk-notification-banner govuk-notification-banner--success"
          role="alert"
          aria-labelledby="govuk-notification-banner-title"
          data-module="govuk-notification-banner">
          <div class="govuk-notification-banner__header">
            <h2
              class="govuk-notification-banner__title"
              id="govuk-notification-banner-title-hold-added">
              Success
            </h2>
          </div>
          <div class="govuk-notification-banner__content">
            <h3 class="govuk-notification-banner__heading">
              Payment hold for {{ frn }} | {{ holdCategoryName }} has been
              removed.
            </h3>
          </div>
        </div>
      {% endif %}

      <h1 class="govuk-heading-l">{{ pageTitle }}</h1>

      {% if paymentHolds.length %}
        {% if numberOfHolds == 1 %}
          {% set holdLabel = 'payment hold' %}
        {% else %}
          {% set holdLabel = 'payment holds' %}
        {% endif %}

        {% if frn and schemeName %}
          <p class="govuk-body">
            We’ve found {{ numberOfHolds }} {{ holdLabel }} for {{
              schemeName
            }} and {{ frn }}.
          </p>
        {% elseif frn %}
          <p class="govuk-body">
            We’ve found {{ numberOfHolds }} {{ holdLabel }} for FRN {{ frn }}.
          </p>
        {% elseif schemeName %}
          <p class="govuk-body">
            We’ve found {{ numberOfHolds }} {{ holdLabel }} for {{
              schemeName
            }}.
          </p>
        {% else %}
          <p class="govuk-body">
            We’ve found {{ numberOfHolds }} {{ holdLabel }}.
          </p>
        {% endif %}
        <div class="govuk-grid-row">
          <div class="govuk-grid-column-one-half">
            <div style="display:flex;align-items:baseline;gap:1rem;">
              <h2 class="govuk-heading-m govuk-!-margin-0">Payment holds</h2>
            </div>
          </div>

          <div class="govuk-grid-column-one-half govuk-!-padding-top-1">
            <div
              style="display:flex;align-items:baseline;justify-content:flex-end;">
              <div
                class="govuk-body-s"
                aria-label="Records per page"
                style="white-space:nowrap;vertical-align:baseline;">
                <span>Number of records per page:</span>&nbsp;
                {% set perPageOptions = [100, 500, 1000] %}
                {% for opt in perPageOptions %}
                  {% if perPage == opt %}
                    <strong>{{ opt }}</strong>
                  {% else %}
                    <a
                      href="/payment-holds/results?perPage={{ opt }}&page=1{% if frn %}&frn={{ frn }}{% endif %}{% if schemeName %}&name={{ schemeName | urlencode }}{% endif %}"
                      class="govuk-link">{{ opt }}</a>
                  {% endif %}
                  {% if not loop.last %}
                    &nbsp;|&nbsp;
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          </div>
        </div>
        <div style="clear: both;"></div>

        <table class="govuk-table">
          <thead class="govuk-table__head">
            <tr class="govuk-table__row">
              <th
                scope="col"
                class="govuk-table__header">
                FRN
              </th>
              <th
                scope="col"
                class="govuk-table__header">
                Description
              </th>
              <th
                scope="col"
                class="govuk-table__header">
                Scheme
              </th>
              <th
                scope="col"
                class="govuk-table__header">
                Marketing Year
              </th>
              <th
                scope="col"
                class="govuk-table__header">
                Contract Number
              </th>
              <th
                scope="col"
                class="govuk-table__header">
                Agreement Number
              </th>
              <th
                scope="col"
                class="govuk-table__header">
                Created
              </th>
              <th
                scope="col"
                class="govuk-table__header">
                Actions
              </th>
            </tr>
          </thead>
          <tbody class="govuk-table__body">
            {% for paymentHold in paymentHolds %}
              <tr class="govuk-table__row">
                <td class="govuk-table__cell">{{ paymentHold.frn }}</td>
                <td class="govuk-table__cell">
                  {{ paymentHold.holdCategoryName }}
                </td>
                <td class="govuk-table__cell">
                  {{ paymentHold.holdCategorySchemeName }}
                </td>
                <td class="govuk-table__cell">
                  {{ paymentHold.marketingYear }}
                </td>
                <td class="govuk-table__cell">
                  {{ paymentHold.contractNumber }}
                </td>
                <td class="govuk-table__cell">
                  {{ paymentHold.agreementNumber }}
                </td>
                <td class="govuk-table__cell">
                  {{ paymentHold.dateTimeAdded }}
                </td>
                <td class="govuk-table__cell">
                  {% if paymentHold.canBeRemoved %}
                    <form
                      method="post"
                      action="/payment-holds/remove-confirm">
                      <input
                        type="hidden"
                        name="crumb"
                        value="{{ crumb }}"
                      />
                      <input
                        type="hidden"
                        name="holdId"
                        value="{{ paymentHold.holdId }}"
                      />
                      <input
                        type="hidden"
                        name="frn"
                        value="{{ paymentHold.frn }}"
                      />
                      <input
                        type="hidden"
                        name="schemeName"
                        value="{{ schemeName }}"
                      />
                      <input
                        type="hidden"
                        name="holdCategoryName"
                        value="{{ paymentHold.holdCategoryName }}"
                      />
                      <button class="govuk-button-link">Remove</button>
                    </form>
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>

        <nav
          class="govuk-pagination"
          aria-label="Pagination">
          {% if (page | default(1)) > 1 %}
            <div class="govuk-pagination__prev">
              <a
                class="govuk-link govuk-pagination__link"
                href="/payment-holds/results?page={{ page - 1 }}&perPage={{ perPage }}{% if frn %}&frn={{ frn }}{% endif %}{% if schemeName %}&name={{ schemeName | urlencode }}{% endif %}"
                rel="prev">
                <svg
                  class="govuk-pagination__icon govuk-pagination__icon--prev"
                  xmlns="http://www.w3.org/2000/svg"
                  height="13"
                  width="15"
                  aria-hidden="true"
                  focusable="false"
                  viewBox="0 0 15 13">
                  <path
                    d="m6.5938-0.0078125-6.7266 6.7266 6.7441 6.4062 1.377-1.449-4.1856-3.9768h12.896v-2h-12.984l4.2931-4.293-1.414-1.414z">
                  </path>
                </svg>
                <span class="govuk-pagination__link-title">
                  Previous<span class="govuk-visually-hidden"> page</span>
                </span>
              </a>
            </div>
          {% endif %}

          <ul class="govuk-pagination__list">
            <li class="govuk-pagination__item govuk-pagination__item--current">
              <span class="govuk-pagination__link-title">
                {{ page | default(1) }}
                <span class="govuk-visually-hidden"> page</span>
              </span>
            </li>
          </ul>

          {% if paymentHolds.length >= perPage %}
            <div class="govuk-pagination__next">
              <a
                class="govuk-link govuk-pagination__link"
                href="/payment-holds/results?page={{ (page | default(1)) + 1 }}&perPage={{ perPage }}{% if frn %}&frn={{ frn }}{% endif %}{% if schemeName %}&name={{ schemeName | urlencode }}{% endif %}"
                rel="next">
                <span class="govuk-pagination__link-title">
                  Next<span class="govuk-visually-hidden"> page</span>
                </span>
                <svg
                  class="govuk-pagination__icon govuk-pagination__icon--next"
                  xmlns="http://www.w3.org/2000/svg"
                  height="13"
                  width="15"
                  aria-hidden="true"
                  focusable="false"
                  viewBox="0 0 15 13">
                  <path
                    d="m8.107-0.0078125-1.4136 1.414 4.2926 4.293h-12.986v2h12.896l-4.1855 3.9766 1.377 1.4492 6.7441-6.4062-6.7246-6.7266z">
                  </path>
                </svg>
              </a>
            </div>
          {% endif %}
        </nav>
      {% else %}
        <p class="govuk-body">
          {% if frn and schemeName %}
            No payment holds found for {{ schemeName }} and {{ frn }}. <a
              class="govuk-link"
              href="/payment-holds/search">Start a new search</a>.
          {% elseif frn %}
            No payment holds found for FRN {{ frn }}. <a
              class="govuk-link"
              href="/payment-holds/search">Start a new search</a>.
          {% elseif schemeName %}
            No payment holds found for {{ schemeName }}. <a
              class="govuk-link"
              href="/payment-holds/search">Start a new search</a>.
          {% else %}
            No payment holds found. <a
              class="govuk-link"
              href="/payment-holds/search">Start a new search</a>.
          {% endif %}
        </p>
      {% endif %}
    </div>
  </div>
{% endblock %}
