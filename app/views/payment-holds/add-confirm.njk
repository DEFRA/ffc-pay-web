{% extends '_layout.njk' %}

{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}

{% set pageTitle = "Check the new payment hold is correct before creating" %}

{% block pageTitle %}{{ pageTitle }} - {{ serviceName }}{% endblock %}

{% block beforeContent %}
  {{ govukBreadcrumbs({
    items: [{
      text: "Home",
      href: "/"
    },{
      text: "Manage payment holds",
      href: "/payment-holds/manage"
    },{
      text: "Create a payment hold",
      href: "/payment-holds/add"
    }, {
      text: pageTitle
    }]
  })}}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h1 class="govuk-heading-l">{{ pageTitle }}</h1>

      <div class="govuk-summary-card">
        <div class="govuk-summary-card__title-wrapper">
          <h2 class="govuk-summary-card__title">
            Payment hold
          </h2>
          <ul class="govuk-summary-card__actions">
            <li class="govuk-summary-card__action">
              <a class="govuk-link" href="/payment-holds/add?frn={{ frn }}&holdCategoryId={{ holdCategoryId }}">Change<span class="govuk-visually-hidden"> payment hold</span></a>
            </li>
          </ul>
        </div>
        <div class="govuk-summary-card__content">
          <dl class="govuk-summary-list">
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">
                FRN (Firm Reference Number)
              </dt>
              <dd class="govuk-summary-list__value">
                {{ frn }}
              </dd>
            </div>
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">
                Scheme
              </dt>
              <dd class="govuk-summary-list__value">
                {{ selectedScheme }}
              </dd>
            </div>
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">
                Hold type
              </dt>
              <dd class="govuk-summary-list__value">
                {{ holdCategoryName }}
              </dd>
            </div>
          </dl>
        </div>
      </div>

      <form method="POST" action="/payment-holds/add" autocomplete="off" novalidate>
        <input type="hidden" name="crumb" value="{{ crumb }}"/>
        <input type="hidden" name="frn" value="{{ frn }}"/>
        <input type="hidden" name="holdCategoryId" value="{{ holdCategoryId }}"/>
        <button class="govuk-button" id="submit">
          Create payment hold
        </button>
      </form>
    </div>
  </div>
{% endblock %}