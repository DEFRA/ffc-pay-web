{% extends "_layout.njk" %}

{% from 'macros/report-form-fields.njk' import reportPageTitle %}
{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}

{% block pageTitle %}{{ reportTitle }} - {{ serviceName }}{% endblock %}

{% block beforeContent %}
  {{ govukBreadcrumbs({
    items: [{
      text: "Home",
      href: "/"
    },{
      text: "Payment statement status report",
      href: "/status-report"
    }, {
      text: reportTitle
    }]
  })}}
{% endblock %}

{% block content %}
  {{ reportPageTitle(reportTitle) }}

  <p class="govuk-body">
    Download available reports as a CSV file to your device or
    <a class="govuk-link" href="/status-report">start a new search</a>.
  </p>

  <h2 class="govuk-heading-m">Available reports</h2>

  {% if reportRows.length %}
    <div class="govuk-summary-list">
      {% for report in reportRows %}
        <div class="govuk-summary-list__row status-report-row">
            <a class="govuk-link" href="{{ report.prepareHref }}">{{ report.date }}  {{ report.fileType }}  {{ report.fileSize }}</a>
        </div>
      {% endfor %}
    </div>
  {% else %}
    <p class="govuk-body">No reports are available for this scheme and year.</p>
  {% endif %}
{% endblock %}
